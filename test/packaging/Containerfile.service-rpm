ARG BASE_IMAGE
FROM ${BASE_IMAGE}
RUN dnf --assumeyes --setopt=install_weak_deps=False install systemd dbus-daemon ca-certificates curl python3 procps-ng util-linux && dnf clean all
RUN . /etc/os-release; if [ "$VERSION_ID" = 43 ]; then systemctl enable dbus-broker.service; else systemctl enable dbus-daemon.service; fi
ENV container=podman
STOPSIGNAL SIGRTMIN+3
CMD ["/sbin/init"]
