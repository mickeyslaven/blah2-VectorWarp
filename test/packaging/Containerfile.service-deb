ARG BASE_IMAGE
FROM ${BASE_IMAGE}
COPY apt-install-with-retry.sh /usr/local/bin/apt-install-with-retry
RUN chmod 0755 /usr/local/bin/apt-install-with-retry && \
    /usr/local/bin/apt-install-with-retry systemd systemd-sysv dbus ca-certificates curl python3 procps util-linux
ENV container=podman
STOPSIGNAL SIGRTMIN+3
CMD ["/sbin/init"]
