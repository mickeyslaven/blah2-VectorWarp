# Keep build availability separate from runtime device qualification. Resident
# processing requires the Linux FP64 proof. The independent wideband/channelizer
# stage is FP32 and supports Linux and macOS/MoltenVK.
function(blah2_gpu_platform_policy system gpu advanced resident resident_reason wideband wideband_reason)
  if(NOT gpu MATCHES "^(AUTO|ON|OFF)$")
    message(FATAL_ERROR "BLAH2_GPU must be AUTO, ON or OFF")
  endif()
  if(NOT advanced MATCHES "^(AUTO|ON|OFF)$")
    message(FATAL_ERROR "BLAH2_GPU_ADVANCED must be AUTO, ON or OFF")
  endif()
  set(resident_available FALSE)
  set(wideband_available FALSE)
  if(advanced STREQUAL "OFF")
    set(resident_detail "disabled by BLAH2_GPU_ADVANCED=OFF")
    set(wideband_detail "disabled by BLAH2_GPU_ADVANCED=OFF")
  elseif(gpu STREQUAL "OFF")
    set(resident_detail "disabled by BLAH2_GPU=OFF; CPU processing remains available")
    set(wideband_detail "disabled by BLAH2_GPU=OFF; CPU processing remains available")
  elseif(system STREQUAL "Linux")
    set(resident_available TRUE)
    set(wideband_available TRUE)
    set(resident_detail "requires Vulkan/glslang/VkFFT and a runtime-qualified shaderFloat64 device")
    set(wideband_detail "requires Vulkan/glslang/VkFFT and a runtime-qualified FP32 compute device")
  elseif(system STREQUAL "Darwin")
    set(resident_detail "unsupported on Darwin: resident FP64 arithmetic proof is Linux-only")
    set(wideband_available TRUE)
    set(wideband_detail "requires Vulkan/MoltenVK, glslang, VkFFT and a runtime-qualified FP32 compute device")
  else()
    set(resident_detail "unsupported on ${system}: resident FP64 arithmetic proof is Linux-only")
    set(wideband_detail "unsupported on ${system}: native FP32 wideband backend is not qualified")
  endif()
  if(advanced STREQUAL "ON" AND NOT resident_available AND NOT wideband_available)
    message(FATAL_ERROR "BLAH2_GPU_ADVANCED=ON cannot be satisfied: ${resident_detail}; ${wideband_detail}")
  endif()
  set(${resident} ${resident_available} PARENT_SCOPE)
  set(${resident_reason} "${resident_detail}" PARENT_SCOPE)
  set(${wideband} ${wideband_available} PARENT_SCOPE)
  set(${wideband_reason} "${wideband_detail}" PARENT_SCOPE)
endfunction()
