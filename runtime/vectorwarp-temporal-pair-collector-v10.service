[Unit]
Description=VectorWarp bounded temporal observer pair collector
After=vectorwarp-api.service vectorwarp-processor.service
Requires=vectorwarp-api.service vectorwarp-processor.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/vectorwarp/live-patches/20261114-shadow-v10/collect-live-temporal-pairs.py --output /var/lib/vectorwarp-api/temporal-pairs/homeportal-wpxi-20261114-v10.jsonl --max-bytes 34359738368 --max-failures 40 --processor-binary /opt/vectorwarp/live-patches/20261114-shadow-v10/blah2 --config-file /etc/vectorwarp/config.yml --require-provenance
Nice=10
CPUQuota=10%
MemoryMax=256M
IOSchedulingClass=idle
Restart=on-failure
RestartSec=5s
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/vectorwarp-api/temporal-pairs

[Install]
WantedBy=multi-user.target
