{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vectorwarp-report-relay",
  "main": "src/index.js",
  "compatibility_date": "2026-10-24",
  "workers_dev": true,
  "observability": {
    "enabled": false
  },
  "vars": {
    "REPORT_LABELS": "bug,vectorwarp-report"
  },
  "ratelimits": [
    {
      "name": "REPORT_RATE_LIMITER",
      "namespace_id": "24102401",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {"name": "REPORT_DEDUPLICATOR", "class_name": "ReportDeduplicator"}
    ]
  },
  "migrations": [
    {"tag": "v1", "new_sqlite_classes": ["ReportDeduplicator"]}
  ]
}
