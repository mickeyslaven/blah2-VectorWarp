[Unit]
Description=VectorWarp radar processor
Documentation=https://github.com/mickeyslaven/blah2-VectorWarp
After=network-online.target vectorwarp-api.service
Wants=network-online.target
# A direct API restart closes the processor's output socket. Propagate that
# restart so the processor is quiesced first and never remains active/no-frame.
PartOf=vectorwarp-api.service

[Service]
Type=simple
User=vectorwarp
Group=vectorwarp
SupplementaryGroups=vectorwarp-config
WorkingDirectory=/var/lib/vectorwarp
Environment=VECTORWARP_LINUX_SERVICE=1
# Exit 1-254 from ExecCondition skips startup without entering a restart loop.
ExecCondition=/usr/bin/node @PREFIX@/current/api/receiver-start-check.js @SYSCONFDIR@/config.yml
ExecStart=@PREFIX@/current/bin/blah2 --config @SYSCONFDIR@/config.yml
Restart=on-failure
RestartPreventExitStatus=78
RestartSec=3s
UMask=0007
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ReadWritePaths=/var/lib/vectorwarp

[Install]
WantedBy=multi-user.target
