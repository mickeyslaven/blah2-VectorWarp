[Unit]
Description=VectorWarp frequency-resolved multipath shadow
Documentation=https://github.com/mickeyslaven/blah2-VectorWarp
After=network-online.target vectorwarp-heimdall.service vectorwarp-api.service
Wants=network-online.target

[Service]
Type=oneshot
User=vectorwarp-api
Group=vectorwarp-api
WorkingDirectory=/opt/vectorwarp/frequency-resolved-shadow
Environment="VECTORWARP_CONFIG_URL=http://127.0.0.1:3000/api/config"
Environment="VECTORWARP_SHADOW_OUTPUT=/var/lib/vectorwarp-api/calibration/frequency-resolved-reference.json"
EnvironmentFile=-/etc/vectorwarp/frequency-resolved-shadow.env
ExecStart=/usr/bin/node /opt/vectorwarp/frequency-resolved-shadow/script/run-frequency-resolved-shadow.js --config-url ${VECTORWARP_CONFIG_URL} --output ${VECTORWARP_SHADOW_OUTPUT}
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ReadWritePaths=/var/lib/vectorwarp-api
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

