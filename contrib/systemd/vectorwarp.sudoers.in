# The web API may queue exactly one root-owned oneshot. That unit invokes an
# argument-free helper for the two VectorWarp units and, for explicitly applied
# live RSPduo settings, a narrowly checked already-installed SDRplay service.
Defaults:vectorwarp-api !requiretty
vectorwarp-api ALL=(root) NOPASSWD: /usr/bin/systemctl --no-block start vectorwarp-restart.service
# Compile only the installed, verified source kit; no caller arguments or SDK download.
vectorwarp-api ALL=(root) NOPASSWD: /usr/bin/systemctl start --no-block vectorwarp-sdrplay-build.service
