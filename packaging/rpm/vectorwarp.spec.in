Name:           vectorwarp
Version:        @VERSION@
Release:        @RPM_RELEASE@
Summary:        Native passive-radar processor and web interface
License:        MIT
URL:            https://github.com/mickeyslaven/blah2-VectorWarp
Packager:       Mickey Slaven <mickeyslaven@gmail.com>
Source0:        vectorwarp-root.tar
Source1:        finalize-rspduo-kit.py
Requires:       systemd
Requires:       sudo
Requires:       python3
Requires:       shadow-utils
Requires:       gcc-c++
Requires:       binutils
%if 0%{?fedora} == 44
Requires:       python3-libdnf5
Requires:       python3-rpm
%endif

%global debug_package %{nil}
# Preserve every distro post-processing step, then bind the kit to the actual
# final core bytes before RPM calculates its file digests and creates the payload.
%global vectorwarp_saved_os_install_post %{__os_install_post}
%global __os_install_post %{vectorwarp_saved_os_install_post} /usr/bin/python3 -I "%{SOURCE1}" "%{buildroot}"
# The vendor SDRplay API is installed separately under its own license. Its
# absence must not block installation or use of the other receiver adapters.
%global __requires_exclude ^libsdrplay_api[.]so.*$

%description
VectorWarp is a native passive-radar processor and local web interface. This
package includes Kraken, USRP and dual HackRF receiver adapters plus a local
RSPduo source kit, CPU processing and optional Vulkan acceleration selected at
runtime. RSPduo needs the separately installed SDRplay API and an explicit
local build. Receiver software is checked in Settings.

%prep

%build

%install
mkdir -p %{buildroot}
tar -C %{buildroot} -xf %{SOURCE0}

%post
if command -v systemd-sysusers >/dev/null 2>&1; then
  systemd-sysusers /usr/lib/sysusers.d/vectorwarp.conf
fi
if getent group vectorwarp-config >/dev/null 2>&1 &&
    getent passwd vectorwarp-api >/dev/null 2>&1; then
  chown root:vectorwarp-config /etc/vectorwarp
  chown vectorwarp-api:vectorwarp-config /etc/vectorwarp/config.yml
fi
if command -v systemd-tmpfiles >/dev/null 2>&1; then
  systemd-tmpfiles --create /usr/lib/tmpfiles.d/vectorwarp.conf
fi
if command -v udevadm >/dev/null 2>&1; then
  udevadm control --reload ||
    printf '%s\n' 'HackRF udev rule reload needs local review; reconnect after reloading rules.' >&2
fi
/usr/bin/python3 -I /opt/vectorwarp/libexec/vectorwarp-sudoers-migrate ||
  printf '%s\n' 'VectorWarp sudoers needs administrator review; customized content was preserved.' >&2
# Only existing render/video groups owning trusted DRM nodes; no driver or service changes.
/usr/bin/python3 -I /opt/vectorwarp/libexec/vectorwarp-gpu-setup --configure-service-access ||
  printf '%s\n' 'GPU access needs local review: sudo /opt/vectorwarp/libexec/vectorwarp-gpu-setup --enable-service-access' >&2
if [ -d /run/systemd/system ]; then
  systemctl daemon-reload >/dev/null || true
  # A running old broker may own an authorized transaction. Defer its and the
  # API's code refresh to an administrator; start only when both are inactive.
  /opt/vectorwarp/libexec/vectorwarp-activate-web ||
    printf '%s\n' 'VectorWarp installed, but web activation failed; inspect: systemctl status vectorwarp-api.service --no-pager' >&2
fi
# Initial install only: the optional fixed helper may start a preinstalled
# vendor SDRplay service after its own manifest/policy checks. It never
# downloads vendor software, accepts a license, enables boot, or starts
# VectorWarp services. Upgrades deliberately skip this action.
if [ "$1" -eq 1 ] && [ -d /run/systemd/system ] &&
    [ -x /opt/vectorwarp/libexec/vectorwarp-sdrplay-service ]; then
  /usr/bin/python3 -I /opt/vectorwarp/libexec/vectorwarp-sdrplay-service install ||
    printf '%s\n' 'SDRplay was not prepared; install its Hardware API yourself from https://sdrplay.com/hardware-api/ and recheck in Settings.' >&2
fi
# Package installation never starts radar processing.

%postun
if [ -d /run/systemd/system ]; then
  systemctl daemon-reload >/dev/null || true
fi
if command -v udevadm >/dev/null 2>&1; then
  udevadm control --reload >/dev/null 2>&1 || true
fi

%preun
if [ "$1" -eq 0 ] && [ -d /run/systemd/system ]; then
  systemctl stop vectorwarp-processor.service vectorwarp-api.service \
    vectorwarp-restart.service vectorwarp-sdrplay-build.service \
    vectorwarp-receiver.service vectorwarp-receiver.socket >/dev/null 2>&1 || true
fi

%files
/opt/vectorwarp
/usr/lib/systemd/system/vectorwarp-api.service
/usr/lib/systemd/system/vectorwarp-processor.service
/usr/lib/systemd/system/vectorwarp-restart.service
/usr/lib/systemd/system/vectorwarp-sdrplay-build.service
/usr/lib/systemd/system/vectorwarp-receiver.service
/usr/lib/systemd/system/vectorwarp-receiver.socket
/usr/lib/systemd/system/vectorwarp-api.service.wants
/usr/lib/sysusers.d/vectorwarp.conf
/usr/lib/udev/rules.d/72-vectorwarp-hackrf.rules
/usr/lib/tmpfiles.d/vectorwarp.conf
%config(noreplace) /etc/sudoers.d/vectorwarp
%dir /etc/vectorwarp-management
%config(noreplace) /etc/vectorwarp-management/receivers.json
%dir %attr(0770,root,root) /etc/vectorwarp
%config(noreplace) %attr(0660,root,root) /etc/vectorwarp/config.yml

%changelog
* Thu Sep 10 2026 Mickey Slaven <mickeyslaven@gmail.com> - @VERSION@-@RPM_RELEASE@
- Automated native release package.
