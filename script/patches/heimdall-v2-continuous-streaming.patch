diff --git a/heimdall_v2/config.h b/heimdall_v2/config.h
index 459f21a..cf9a71e 100644
--- a/heimdall_v2/config.h
+++ b/heimdall_v2/config.h
@@ -161 +161,6 @@
-#define PERIODIC_RECAL_DEFAULT_ENABLED  1      // default ON
+//
+// A check switches the calibration noise source into the antenna stream for
+// about one second. That gap is unacceptable to continuous consumers such as
+// passive radar, so make the intrusive check opt-in. Startup calibration and
+// transport-integrity recovery remain enabled and still recover sample loss.
+#define PERIODIC_RECAL_DEFAULT_ENABLED  0      // opt-in; continuous stream by default
