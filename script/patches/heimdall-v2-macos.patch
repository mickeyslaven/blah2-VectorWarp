+PacketWriteResult send_packet_with_deadline(int socket, const uint8_t* data, size_t size,
+                                            std::chrono::milliseconds deadline) {
+    const auto started = std::chrono::steady_clock::now();
+    const auto until = started + deadline;
+    size_t offset = 0;
+    auto failed = [&](PacketWriteFailure failure, int error_number) {
+        return PacketWriteResult{false, offset, failure, error_number,
+            std::chrono::duration_cast<std::chrono::milliseconds>(
+                std::chrono::steady_clock::now() - started).count()};
+    };
+    while (offset < size) {
+        const auto now = std::chrono::steady_clock::now();
+        if (now >= until) return failed(PacketWriteFailure::deadline, 0);
+        const ssize_t sent = sock_send(socket, data + offset, size - offset, MSG_NOSIGNAL);
+        if (sent > 0) { offset += static_cast<size_t>(sent); continue; }
+        if (sent == 0) return failed(PacketWriteFailure::peer_closed, 0);
+        if (errno == EINTR) continue;
+        if (errno == EAGAIN || errno == EWOULDBLOCK) {
+            const auto remaining = std::chrono::duration_cast<std::chrono::microseconds>(
+                until - std::chrono::steady_clock::now());
+            if (remaining.count() <= 0) return failed(PacketWriteFailure::deadline, 0);
+            fd_set write_fds;
+            FD_ZERO(&write_fds);
+            FD_SET(socket, &write_fds);
+            timeval timeout{};
+            timeout.tv_sec = static_cast<decltype(timeout.tv_sec)>(remaining.count() / 1000000);
+            timeout.tv_usec = static_cast<decltype(timeout.tv_usec)>(remaining.count() % 1000000);
+            const int rc = sock_select(socket + 1, nullptr, &write_fds, nullptr, &timeout);
+            if (rc > 0 && FD_ISSET(socket, &write_fds)) continue;
+            if (rc < 0 && errno == EINTR) continue;
+            if (rc == 0) return failed(PacketWriteFailure::deadline, 0);
+            return failed(PacketWriteFailure::socket_error, rc < 0 ? errno : 0);
+        }
+        return failed((errno == EPIPE || errno == ECONNRESET)
+            ? PacketWriteFailure::peer_closed : PacketWriteFailure::socket_error, errno);
+    }
+    return PacketWriteResult{true, offset, PacketWriteFailure::none, 0,
+        std::chrono::duration_cast<std::chrono::milliseconds>(
+            std::chrono::steady_clock::now() - started).count()};
+}
