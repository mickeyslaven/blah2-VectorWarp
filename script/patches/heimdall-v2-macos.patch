+PacketWriteResult send_packet_with_deadline(int socket, const uint8_t* data, size_t size, std::chrono::milliseconds deadline) {
+    const auto started = std::chrono::steady_clock::now();
+    const auto until = started + deadline;
+    size_t offset = 0;
+    auto failed = [&](PacketWriteFailure failure, int error_number) {
+        return PacketWriteResult{false, offset, failure, error_number,
+            std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::steady_clock::now() - started).count()};
+    };
+    while (offset < size) {
+        if (std::chrono::steady_clock::now() >= until) return failed(PacketWriteFailure::deadline, 0);
+        const ssize_t sent = send(socket, data + offset, size - offset, MSG_NOSIGNAL);
+        if (sent > 0) { offset += static_cast<size_t>(sent); continue; }
+        if (sent == 0) return failed(PacketWriteFailure::peer_closed, 0);
+        if (errno == EINTR) continue;
+        if (errno == EAGAIN || errno == EWOULDBLOCK) {
+            const auto now = std::chrono::steady_clock::now();
+            if (now >= until) return failed(PacketWriteFailure::deadline, 0);
+            const auto remaining = std::chrono::duration_cast<std::chrono::milliseconds>(until - now).count();
+            pollfd fd{socket, POLLOUT, 0};
+            const int rc = poll(&fd, 1, static_cast<int>(std::max<long long>(1, remaining)));
+            const int poll_errno = rc < 0 ? errno : 0;
+            if (rc > 0 && (fd.revents & POLLOUT)) continue;
+            if (rc < 0 && poll_errno == EINTR) continue;
+            if (rc == 0) return failed(PacketWriteFailure::deadline, 0);
+            if (rc < 0) return failed(PacketWriteFailure::socket_error, poll_errno);
+            if (fd.revents & POLLHUP) return failed(PacketWriteFailure::peer_closed, 0);
+            // POLLERR/POLLNVAL and unusual revents are local/socket errors;
+            // never reuse errno from the earlier EAGAIN send.
+            if (fd.revents & POLLNVAL) return failed(PacketWriteFailure::socket_error, EBADF);
+            return failed(PacketWriteFailure::socket_error, 0);
+        }
+        return failed((errno == EPIPE || errno == ECONNRESET) ? PacketWriteFailure::peer_closed : PacketWriteFailure::socket_error, errno);
+    }
+    return PacketWriteResult{true, offset, PacketWriteFailure::none, 0,
+        std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::steady_clock::now() - started).count()};
