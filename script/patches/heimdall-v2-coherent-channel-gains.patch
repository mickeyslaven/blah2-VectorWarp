+        const size_t key = json_str.find("\"gains\":");
+        const size_t begin = key == std::string::npos ? std::string::npos : json_str.find('[', key + 8);
+        const size_t end = begin == std::string::npos ? std::string::npos : json_str.find(']', begin + 1);
