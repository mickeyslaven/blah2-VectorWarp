+        }
+        if (gains.size() != static_cast<size_t>(active_num_elements.load(std::memory_order_acquire)))
+            return "{\"status\":\"error\",\"message\":\"gain count must equal active channel count\"}";
+        try {
+            const bool changed = update_coherent_channel_gains(gains, devices);
+            if (changed) begin_retune_cooldown("Per-channel gains changed");
+        } catch (const std::exception& error) {
+            return "{\"status\":\"error\",\"message\":\"" + std::string(error.what()) + "\"}";
+        }
+        std::ostringstream response;
+        response << "{\"status\":\"success\",\"channel_gains\":[";
+        for (size_t i = 0; i < gains.size(); ++i) {
+            if (i > 0) response << ",";
+            response << gains[i] / 10.0;
+        }
+        response << "]}";
+        return response.str();
+    }
