+bool update_coherent_channel_gains(const std::vector<int>& gains,
+                                   const std::vector<std::unique_ptr<SDRDevice>>& devices) {
+    std::lock_guard<std::recursive_mutex> calibration_lock(calibration_mutex);
+    if (operating_mode.load(std::memory_order_acquire) != OperatingMode::COHERENT)
+        throw std::runtime_error("per-channel gains require coherent mode");
+    const int active = active_num_elements.load(std::memory_order_acquire);
+    if (active < 2 || gains.size() != static_cast<size_t>(active))
+        throw std::runtime_error("per-channel gain count must equal active channel count");
+    if (std::any_of(gains.begin(), gains.end(), [](int gain) { return gain < 0 || gain > 500; }))
+        throw std::runtime_error("per-channel gains must be manual values from 0 through 50 dB");
+
+    std::lock_guard<std::mutex> settings_lock(settings_mutex);
+    if (hardware_settings_failed.load(std::memory_order_acquire) ||
+        (calibration_failed.load(std::memory_order_acquire) && coherence_lost.load(std::memory_order_acquire)))
+        throw std::runtime_error("receiver settings or coherence recovery failed; restart required");
+    std::lock_guard<std::recursive_mutex> device_lock(device_io_mutex);
+
+    std::vector<int> previous(static_cast<size_t>(active), -999);
+    bool unchanged = true;
+    for (int i = 0; i < active; ++i) {
+        if (static_cast<size_t>(i) >= devices.size() || !devices[i] || !devices[i]->dev)
+            throw std::runtime_error("active channel is unavailable");
+        previous[static_cast<size_t>(i)] = devices[i]->actual_gain_tenths.load(std::memory_order_acquire);
+        if (previous[static_cast<size_t>(i)] < 0)
+            throw std::runtime_error("active channel gain readback is unavailable");
+        unchanged = unchanged && previous[static_cast<size_t>(i)] == gains[static_cast<size_t>(i)];
+    }
+    if (unchanged) return false;
+
+    begin_acquisition_transition();
+    if (phase_compensation && !recovery_in_progress.load(std::memory_order_acquire)) {
+        std::lock_guard<std::mutex> state_lock(phase_compensation->state_mutex);
+        phase_compensation->state = PhaseCompensatorState::WAITING_FOR_STABILITY;
+        phase_compensation->last_frequency_change = std::chrono::steady_clock::now();
+        phase_compensation->cooldown_active = true;
+        phase_compensation->compensation_applied = false;
+        phase_compensation->stable_nonzero_count = 0;
+        per_bin_cal.ready.store(false, std::memory_order_release);
+    }
+
+    auto apply = [&](const std::vector<int>& requested, std::vector<char>& ok) {
+        ok.assign(static_cast<size_t>(active), 0);
+        std::vector<std::thread> threads;
+        threads.reserve(static_cast<size_t>(active));
+        for (int i = 0; i < active; ++i) {
+            threads.emplace_back([&, i]() {
+                int actual = -999;
+                ok[static_cast<size_t>(i)] = apply_validated_gain(
+                    devices[static_cast<size_t>(i)]->dev, requested[static_cast<size_t>(i)], &actual) &&
+                    actual == requested[static_cast<size_t>(i)];
+                if (ok[static_cast<size_t>(i)])
+                    devices[static_cast<size_t>(i)]->actual_gain_tenths.store(actual, std::memory_order_release);
+            });
+        }
+        for (auto& thread : threads) thread.join();
+    };
+    auto failed = [&](const std::vector<char>& ok) {
+        std::string channels;
+        for (int i = 0; i < active; ++i)
+            if (!ok[static_cast<size_t>(i)])
+                channels += (channels.empty() ? "" : ", ") + std::to_string(i);
+        return channels;
+    };
+
+    std::vector<char> applied;
+    apply(gains, applied);
+    const std::string failed_channels = failed(applied);
+    if (!failed_channels.empty()) {
+        std::cerr << "SDR: coherent channel gain update failed on channel(s) " << failed_channels
+                  << " - restoring every previous gain" << std::endl;
+        std::vector<char> restored;
+        apply(previous, restored);
+        const std::string restore_failed = failed(restored);
+        if (!restore_failed.empty()) {
+            std::cerr << "SDR: coherent channel gain rollback failed on channel(s) " << restore_failed << std::endl;
+            signal_coherence_lost("per-channel gain rollback failed");
+        }
+        hardware_settings_failed.store(true, std::memory_order_release);
+        coherence_lost.store(true, std::memory_order_release);
+        complete_acquisition_transition();
+        throw std::runtime_error("partial per-channel gain update; restart required");
+    }
+
+    for (int i = 0; i < active; ++i)
+        devices[static_cast<size_t>(i)]->adc_headroom.request_reset();
+    complete_acquisition_transition();
+    return true;
+}
