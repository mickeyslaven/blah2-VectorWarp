-	gpio = 1 << gpio;
-	r = rtlsdr_read_reg(dev, SYSB, GPO, 1);
-	r = val ? (r | gpio) : (r & ~gpio);
-	retval = rtlsdr_write_reg(dev, SYSB, GPO, r, 1);
-	return retval;
+	if (!dev || gpio >= 8)
+		return -1;
+	mask = (uint8_t)(1U << gpio);
+	ret = rtlsdr_gpio_read(dev, GPO, &value);
+	if (ret < 0)
+		return ret;
+	value = val ? (uint8_t)(value | mask) : (uint8_t)(value & ~mask);
+	return rtlsdr_gpio_write(dev, GPO, value);
 }
 
