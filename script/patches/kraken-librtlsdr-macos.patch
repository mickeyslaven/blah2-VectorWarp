+/* GPIO control must retain libusb failures and short transfers. The older
+ * uint16_t register API cannot represent a negative USB result. */
+static int rtlsdr_gpio_read(rtlsdr_dev_t *dev, uint16_t addr, uint8_t *value)
+{
+	int ret = rtlsdr_read_array(dev, SYSB, addr, value, 1);
+	return ret == 1 ? 0 : (ret < 0 ? ret : -1);
+}
+
+static int rtlsdr_gpio_write(rtlsdr_dev_t *dev, uint16_t addr, uint8_t value)
+{
+	int ret = rtlsdr_write_array(dev, SYSB, addr, &value, 1);
+	return ret == 1 ? 0 : (ret < 0 ? ret : -1);
+}
+
 int rtlsdr_set_gpio_bit(rtlsdr_dev_t *dev, uint8_t gpio, int val)
 {
-	uint16_t r, retval;
+	uint8_t value, mask;
