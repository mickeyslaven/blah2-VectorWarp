diff --git a/heimdall_v2/src/core/ingest_timing.hpp b/heimdall_v2/src/core/ingest_timing.hpp
new file mode 100644
index 0000000..6a6b6bc
--- /dev/null
+++ b/heimdall_v2/src/core/ingest_timing.hpp
@@ -0,0 +1,51 @@
+#pragma once
+#include <cstdint>
+#include <ctime>
+#ifdef __linux__
+#include <sys/timex.h>
+#endif
+
+// Host receipt of USB data, never an ADC hardware UTC timestamp. Counters
+// describe reference-channel sample positions; calibration delay is not UTC.
+struct IngestTiming {
+    uint64_t first_sample = 0, transfer_sequence = 0, anchor_sample = 0;
+    uint64_t monotonic_ns = 0, tai_ns = 0, realtime_ns = 0;
+    uint64_t clock_read_span_ns = 0, system_maxerror_ns = 0;
+    uint32_t flags = 0;
+};
+
+inline uint64_t ingest_clock(clockid_t clock) {
+    timespec value{};
+    if (clock_gettime(clock, &value) != 0) return 0;
+    return uint64_t(value.tv_sec) * 1000000000ULL + uint64_t(value.tv_nsec);
+}
+
+inline IngestTiming observe_ingest(uint64_t sample, uint64_t transfer) {
+    IngestTiming result;
+    result.first_sample = sample;
+    result.transfer_sequence = transfer;
+    result.monotonic_ns = ingest_clock(CLOCK_MONOTONIC_RAW);
+    if (result.monotonic_ns) result.flags |= 1;
+    result.realtime_ns = ingest_clock(CLOCK_REALTIME);
+#ifdef __linux__
+    result.tai_ns = ingest_clock(CLOCK_TAI);
+    // Per-reader cache: querying kernel discipline every packet is unnecessary.
+    static thread_local timex discipline{};
+    static thread_local int discipline_state = TIME_ERROR;
+    if ((transfer & 127) == 0) {
+        discipline = {};
+        discipline_state = adjtimex(&discipline);
+    }
+    // CLOCK_TAI exists even when no kernel TAI offset has been installed.
+    if (result.tai_ns && discipline.tai > 0) result.flags |= 2;
+    else result.tai_ns = 0;
+    if (discipline_state >= 0 && discipline_state != TIME_ERROR &&
+            !(discipline.status & STA_UNSYNC)) {
+        result.flags |= 4;
+        result.system_maxerror_ns = uint64_t(discipline.maxerror) * 1000;
+    }
+#endif
+    const auto end = ingest_clock(CLOCK_MONOTONIC_RAW);
+    if (end >= result.monotonic_ns) result.clock_read_span_ns = end - result.monotonic_ns;
+    return result;
+}
