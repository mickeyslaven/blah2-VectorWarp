#!/bin/sh
set -eu

if [ "$#" -ne 0 ]; then
  echo 'vectorwarp-restart accepts no arguments' >&2
  exit 64
fi

# This script runs as the root-owned vectorwarp-restart.service, outside the API
# cgroup. Keep processing stopped unless the replacement API is actually ready.
finish() {
  result=$?
  trap - 0
  /usr/bin/env -i PATH=/usr/sbin:/usr/bin:/sbin:/bin LANG=C LC_ALL=C \
    /usr/bin/node @PREFIX@/libexec/vectorwarp-prepare-sdrplay.js --finish "$result" || true
  exit "$result"
}
trap finish 0
trap 'exit 143' TERM
/usr/bin/env -i PATH=/usr/sbin:/usr/bin:/sbin:/bin LANG=C LC_ALL=C \
  /usr/bin/node @PREFIX@/libexec/vectorwarp-prepare-sdrplay.js --begin @SYSCONFDIR@/config.yml
/usr/bin/systemctl stop vectorwarp-processor.service
/usr/bin/systemctl restart vectorwarp-api.service
/usr/bin/node @PREFIX@/libexec/vectorwarp-wait-api.js \
  @SYSCONFDIR@/config.yml @PREFIX@/current/api/node_modules
/usr/bin/env -i PATH=/usr/sbin:/usr/bin:/sbin:/bin LANG=C LC_ALL=C \
  /usr/bin/node @PREFIX@/libexec/vectorwarp-prepare-sdrplay.js \
  @SYSCONFDIR@/config.yml @PREFIX@/current/api @PREFIX@/libexec/vectorwarp-sdrplay-service
processor_attempt=1
while [ "$processor_attempt" -le 5 ]; do
  /usr/bin/systemctl start vectorwarp-processor.service
  if /usr/bin/systemctl is-active --quiet vectorwarp-processor.service; then
    break
  fi
  if [ "$processor_attempt" -eq 5 ]; then
    echo 'Processor remained inactive after receiver preparation; restart is incomplete.' >&2
    exit 78
  fi
  processor_attempt=$((processor_attempt + 1))
  /usr/bin/sleep 1
done
